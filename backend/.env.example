# Server
PORT=5000
NODE_ENV=development

# MongoDB (local install, Docker, or MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/pr_infinity

# Auth: use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# First admin account, created automatically when the database has no users.
# Change the password from the app's Settings screen after the first login.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@prinfinitytech.com
ADMIN_PASSWORD=ChangeMe@123

# Comma-separated list of allowed web origins (the mobile app does not need this). Use * to allow all.
CORS_ORIGINS=*

# Where uploaded invoice PDFs are stored
UPLOAD_DIR=uploads

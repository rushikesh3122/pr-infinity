{
  "expo": {
    "name": "PR Infinity",
    "slug": "pr-infinity",
    "scheme": "prinfinity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F5F9",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prinfinity.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose your company logo and signature for invoices."
      }
    },
    "android": {
      "package": "com.prinfinity.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose your company logo and signature for invoices."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
